# Copy this file to jenkins/.env and fill in your values.
# jenkins/.env is git-ignored - NEVER commit the real token.

# From https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=paste-your-ngrok-authtoken-here

# Your free static domain from https://dashboard.ngrok.com/domains
# (without https://), e.g. something-random-words.ngrok-free.app
NGROK_DOMAIN=your-static-domain.ngrok-free.app
